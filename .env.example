# Copy to .env and fill in keys. Never commit .env.
# The whole system works with LLM_ENABLED=false (deterministic fallback templates).

LLM_ENABLED=true
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openrouter

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Groq model IDs (primary provider)
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_AGENT=openai/gpt-oss-120b

# OpenRouter model IDs (fallback only; leave empty until verified with
# `python -m scripts.list_models --provider openrouter --filter free`)
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_AGENT=

LLM_TIMEOUT_SECONDS=8
AGENT_TIMEOUT_SECONDS=25
AGENT_MAX_TOOL_CALLS=6

DATABASE_URL=sqlite:///data/app.db
